# Copie para .env e troque os valores de exemplo (o .env fica fora do Git).

# PostgreSQL local (docker compose up -d). Use a mesma senha nas duas URLs.
POSTGRES_PASSWORD="troque-esta-senha"
DATABASE_URL="postgresql://easyfood:troque-esta-senha@localhost:5432/easyfood?schema=public"
DIRECT_URL="postgresql://easyfood:troque-esta-senha@localhost:5432/easyfood?schema=public"

# Chave própria da API para assinar os tokens JWT (não é a senha do banco)
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# (Opcional) Pasta onde as imagens enviadas são gravadas. Padrão: ./uploads
# UPLOAD_DIR="./uploads"
