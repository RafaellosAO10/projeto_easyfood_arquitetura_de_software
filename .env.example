# Copie este arquivo para .env e substitua os valores

# Substitua SUA_SENHA_AQUI pela senha do usuário postgres
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/easyfood"

# Chave usada para assinar os tokens JWT. Use um valor longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
