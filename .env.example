# Copie este arquivo para .env e substitua os valores

# PostgreSQL no Supabase (Project Settings > Database > Connection string).
# DATABASE_URL: pooler em modo transação (porta 6543), usado pela API.
# DIRECT_URL:   pooler em modo sessão (porta 5432), usado pelas migrations.
# Para um PostgreSQL local, use a mesma URL nas duas variáveis:
# postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/easyfood
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA_AQUI@aws-0-SUA_REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA_AQUI@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres"

# Chave usada para assinar os tokens JWT. Use um valor longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
