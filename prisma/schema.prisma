// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Restaurant {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(150)
  category    String?    @db.VarChar(100)
  rating      Decimal?   @db.Decimal(2, 1)
  // Dono do restaurante (quem o cadastrou). Opcional porque os restaurantes
  // anteriores a esta versão não têm dono; esses não podem ser gerenciados (ver ADR-007).
  ownerId     Int?
  owner       User?      @relation(fields: [ownerId], references: [id])
  dishes      Dish[]
  favoritedBy Favorite[]
  orders      Order[]
}

model User {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  email       String       @unique @db.VarChar(150)
  password    String       @db.VarChar(255)
  // Caminho público da foto de perfil (ex.: /uploads/users/1-...webp)
  imageUrl    String?      @db.VarChar(255)
  restaurants Restaurant[]
  favorites   Favorite[]
  orders      Order[]
}

model Dish {
  id           Int         @id @default(autoincrement())
  name         String      @db.VarChar(150)
  category     String      @db.VarChar(100)
  description  String      @default("")
  price        Decimal     @db.Decimal(10, 2)
  // Caminho público da imagem; nulo até o dono enviar a foto do prato
  imageUrl     String?     @db.VarChar(255)
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId])
}

// Restaurante favorito de um usuário (tabela de ligação N:N, ver ADR-012).
// A chave composta impede favoritar o mesmo restaurante duas vezes; apagar o
// usuário ou o restaurante apaga os favoritos ligados a ele.
model Favorite {
  userId       Int
  restaurantId Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}

// Etapas de um pedido (ver ADR-013). As transições permitidas ficam em order.service.js.
enum OrderStatus {
  PLACED // recebido, aguardando o restaurante
  PREPARING // em preparo
  OUT_FOR_DELIVERY // saiu para entrega
  DELIVERED // entregue (final)
  CANCELLED // cancelado (final)
}

// Pedido de um cliente para um restaurante (um restaurante por pedido, como o carrinho).
// O total é calculado no servidor a partir dos preços do banco, nunca enviado pelo cliente.
model Order {
  id           Int         @id @default(autoincrement())
  userId       Int
  restaurantId Int
  status       OrderStatus @default(PLACED)
  total        Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        OrderItem[]

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
}

// Item do pedido. Nome e preço são uma "foto" do prato no momento da compra:
// mudar ou apagar o prato depois não altera pedidos antigos (dishId vira nulo).
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  dishId    Int?
  name      String  @db.VarChar(150)
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([dishId])
}
