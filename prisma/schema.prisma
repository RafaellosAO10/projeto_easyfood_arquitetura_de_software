// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Restaurant {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(150)
  category    String?    @db.VarChar(100)
  rating      Decimal?   @db.Decimal(2, 1)
  // Dono do restaurante (quem o cadastrou). Opcional porque os restaurantes
  // anteriores a esta versão não têm dono; esses não podem ser gerenciados (ver ADR-007).
  ownerId     Int?
  owner       User?      @relation(fields: [ownerId], references: [id])
  dishes      Dish[]
  favoritedBy Favorite[]
}

model User {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  email       String       @unique @db.VarChar(150)
  password    String       @db.VarChar(255)
  // Caminho público da foto de perfil (ex.: /uploads/users/1-...webp)
  imageUrl    String?      @db.VarChar(255)
  restaurants Restaurant[]
  favorites   Favorite[]
}

model Dish {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(150)
  category     String     @db.VarChar(100)
  description  String     @default("")
  price        Decimal    @db.Decimal(10, 2)
  // Caminho público da imagem; nulo até o dono enviar a foto do prato
  imageUrl     String?    @db.VarChar(255)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// Restaurante favorito de um usuário (tabela de ligação N:N, ver ADR-012).
// A chave composta impede favoritar o mesmo restaurante duas vezes; apagar o
// usuário ou o restaurante apaga os favoritos ligados a ele.
model Favorite {
  userId       Int
  restaurantId Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}
